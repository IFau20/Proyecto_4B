{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["api/**/*.ts", "backend/**/*.ts"],
  "exclude": ["backend/**/*_test.ts", "backend/server.ts", "backend/scripts/**"]
}
