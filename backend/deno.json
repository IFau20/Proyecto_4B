{
  "tasks": {
    "dev": "deno run --watch --allow-net --allow-read --allow-write=./data --allow-env=PORT,MICROSOFT_TENANT_ID,MICROSOFT_CLIENT_ID,MICROSOFT_CLIENT_SECRET,APP_PUBLIC_ORIGIN,AUTH_REDIRECT_URI server.ts",
    "start": "deno run --allow-net --allow-read --allow-write=./data --allow-env=PORT,MICROSOFT_TENANT_ID,MICROSOFT_CLIENT_ID,MICROSOFT_CLIENT_SECRET,APP_PUBLIC_ORIGIN,AUTH_REDIRECT_URI server.ts",
    "test": "deno test --allow-read",
    "check:live": "deno run --allow-net scripts/checkLive.ts",
    "check:hp": "deno run --allow-net scripts/checkHpLive.ts",
