# Copy to backend/.env, or run scripts/configure-sso.ps1 from PowerShell.
# Register a Microsoft Entra Web application with this exact callback URL:
# http://localhost:8000/api/auth/callback
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
APP_PUBLIC_ORIGIN=http://localhost:5173
AUTH_REDIRECT_URI=http://localhost:8000/api/auth/callback
